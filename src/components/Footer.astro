---
import Brand from './Brand.astro';
import WhatsApp from './WhatsApp.astro';
import { safeUrl } from '../lib.mjs';
const { site } = Astro.props;
const privacy = safeUrl(site.privacyUrl);
---
<footer id="contacto" class="footer container">
  <div class="footer-brand-row"><a href="#inicio" class="brand" aria-label="VAGTech — Inicio"><Brand site={site} /></a><p>{site.slogan}</p><WhatsApp site={site} /></div>
  <div class="footer-links"><a href="#servicios">Servicios</a><a href="#resultados">Resultados</a><a href="#cotizacion">Cotización</a><a href="#sucursales">Sucursales</a>{site.phone && <a href={`tel:${site.phone.international}`}>Llámanos: {site.phone.display}</a>}{site.socialLinks.filter(link => safeUrl(link.url)).map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span>{privacy ? <a href={privacy}>Aviso de privacidad</a> : <span>Aviso de privacidad pendiente</span>}<a href="#inicio">Volver al inicio ↑</a></div>
</footer>
