---
import { Image } from 'astro:assets';
const { site } = Astro.props;
---
{site.logo && <Image src={site.logo.src} alt="" class="brand-emblem" width={48} height={48} widths={[48, 96]} sizes="(max-width: 700px) 34px, 48px" format="webp" quality={85} loading="eager" />}
<span class="wordmark-crop" aria-hidden="true"><Image src={site.logo.src} alt="" width={300} height={300} format="webp" quality={90} loading="eager" /></span>
