---
import Title from './Title.astro';
import SectionLabel from './SectionLabel.astro';
import Media from './Media.astro';
import WhatsApp from './WhatsApp.astro';
const { site, services } = Astro.props;
const secondary = services.filter(service => !service.featured);
const groups = [...new Set(secondary.map(service => service.group || 'Servicios'))];
---
<section id="servicios" class="section container services-section">
  <SectionLabel number="01" text="Servicios" />
  <div class="section-heading"><h2><Title text={site.copy.servicesTitle} /></h2><p>{site.copy.servicesIntro}</p></div>
  <div class="services-layout">
    {services.filter(s => s.featured).map(service => (
      <article class="featured-service">
        <Media image={service.image} variant="service-media" />
        <div class="service-body">
          <span class="micro lime">SERVICIO PRIORITARIO</span><h3>{service.name}</h3>
          {service.provisional && <p class="placeholder-note">Descripción provisional</p>}
          <p>{service.shortDescription}</p>
          <div class="actions"><a class="text-link" href="#cotizacion" data-service={service.id}>Cotizar personalización <span aria-hidden="true">↗</span></a><WhatsApp site={site} /></div>
        </div>
      </article>
    ))}
    <div class="secondary-services">
      {groups.map((group, i) => (
        <article class="service-row service-group"><span class="micro">{String(i + 2).padStart(2, '0')}</span><h3>{group}</h3><ul>{secondary.filter(service => (service.group || 'Servicios') === group).map(service => <li><a href="#cotizacion" data-service={service.id}>{service.name}<span aria-hidden="true">↗</span></a></li>)}</ul></article>
      ))}
      {services.every(s => s.featured) && <div class="catalog-placeholder"><span class="micro">CATÁLOGO POR CONFIRMAR</span><h3>Otros servicios.<br />Mismo espacio,<br />menor jerarquía.</h3><p>Los servicios secundarios aparecerán aquí cuando VAGTech confirme la lista. No se han asumido servicios adicionales.</p><span class="placeholder-tag">Placeholder de contenido</span></div>}
    </div>
  </div>
  {site.assurance && <div class="service-assurance"><div><h3>{site.assurance.warranty}</h3><p>{site.assurance.note}</p></div><div><h3>{site.assurance.certificationsTitle}</h3><ul class="brand-list">{site.assurance.brands.map(brand => <li>{brand}</li>)}</ul></div></div>}
</section>
