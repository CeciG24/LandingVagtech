---
import Title from './Title.astro';
import SectionLabel from './SectionLabel.astro';
import Media from './Media.astro';
import WhatsApp from './WhatsApp.astro';
import Icon from './Icon.astro';
import Certifications from './Certifications.astro';
import { serviceCategories } from '../../content/services.mjs';
const { site, services } = Astro.props;
const secondary = services.filter(service => !service.featured);
---
<section id="servicios" class="section container services-section">
  <SectionLabel number="01" text="Servicios" />
  <div class="section-heading"><h2><Title text={site.copy.servicesTitle} /></h2><p>{site.copy.servicesIntro}</p></div>
  <div class="services-layout">
    {services.filter(s => s.featured).map(service => (
      <article class="featured-service">
        <Media image={service.image} variant="service-media" />
        <div class="service-body">
          <span class="micro lime">SERVICIO PRIORITARIO</span><h3>{service.name}</h3>
          {service.provisional && <p class="placeholder-note">Descripción provisional</p>}
          <p>{service.shortDescription}</p>
          <div class="actions"><a class="text-link" href="#cotizacion" data-service={service.id}>Cotizar personalización <span aria-hidden="true">↗</span></a><WhatsApp site={site} /></div>
        </div>
      </article>
    ))}
  </div>
  <div class="service-cards">{serviceCategories.map(category => <article class="service-card"><Media image={{ src: category.image, alt: '', sizes: '(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 25vw' }} variant="category-media" /><div class="category-body"><span class="category-icon"><Icon name={category.icon} /></span><h3>{category.name}</h3><ul>{secondary.filter(service => service.group === category.name).map(service => <li><a href="#cotizacion" data-service={service.id}>{service.name}<span aria-hidden="true">→</span></a></li>)}</ul></div></article>)}</div>
  {site.assurance && <div class="service-assurance"><div><h3>{site.assurance.warranty}</h3><p>{site.assurance.note}</p></div><Certifications title={site.assurance.certificationsTitle} /></div>}
</section>
