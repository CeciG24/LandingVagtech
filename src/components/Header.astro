---
import Brand from './Brand.astro';
import WhatsApp from './WhatsApp.astro';
const { site } = Astro.props;
---
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="header">
  <div class="container header-inner">
    <a href="#inicio" class="brand" aria-label="VAGTech — Inicio"><Brand site={site} /></a>
    <button class="menu-toggle" aria-controls="navigation" aria-expanded="false" hidden>Menú <span aria-hidden="true">+</span></button>
    <nav id="navigation" aria-label="Navegación principal">
      {site.navigation.map(([id, name]) => <a href={`#${id}`}>{name}</a>)}
    </nav>
    <div class="header-contact"><WhatsApp site={site} /><a class="button button-primary header-quote" href="#cotizacion">Cotizar ahora <span aria-hidden="true">↗</span></a></div>
  </div>
</header>
